{
  "annotations": { "list": [] },
  "title": "容器资源监控",
  "uid": "container-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["cadvisor", "container"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "运行容器数",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "count(count by (name) (container_last_seen{name!=\"\"}))", "legendFormat": "containers" }]
    },
    {
      "id": 2, "type": "stat", "title": "容器总CPU使用率",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) * 100", "legendFormat": "CPU" }]
    },
    {
      "id": 3, "type": "stat", "title": "容器总内存使用",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(container_memory_usage_bytes{name!=\"\"})", "legendFormat": "memory" }]
    },
    {
      "id": 4, "type": "stat", "title": "容器总网络接收",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{name!=\"\"}[1m]))", "legendFormat": "rx" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "各容器CPU使用率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{ "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[1m]) * 100", "legendFormat": "{{name}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "各容器内存使用",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "container_memory_usage_bytes{name!=\"\"}", "legendFormat": "{{name}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "各容器网络IO",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        { "expr": "rate(container_network_receive_bytes_total{name!=\"\"}[1m])", "legendFormat": "RX {{name}}" },
        { "expr": "rate(container_network_transmit_bytes_total{name!=\"\"}[1m])", "legendFormat": "TX {{name}}" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Kafka集群容器CPU对比",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{ "expr": "rate(container_cpu_usage_seconds_total{name=~\"kafka-.*|consumer|filebeat|celery.*\"}[1m]) * 100", "legendFormat": "{{name}}" }]
    }
  ]
}
